<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_GOOGLETAGMANAGER</name>
    <author>HKweb</author>
    <creationDate>26-10-2025</creationDate>
    <copyright>Copyright 2025 HKweb</copyright>
    <license>GPLv3 http://www.gnu.org/licenses/gpl.html</license>
    <authorEmail>info@hkweb.nl</authorEmail>
    <authorUrl>https://hkweb.nl</authorUrl>
    <version>26.35.00</version>
    <description>PLG_SYSTEM_GOOGLETAGMANAGER_XML_DESCRIPTION</description>

    <php_minimum>8.3.0</php_minimum>

    <namespace path="src">HKweb\Plugin\System\GoogleTagManager</namespace>

    <files>
        <folder plugin="googletagmanager">services</folder>
        <folder>src</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_googletagmanager.ini</language>
        <language tag="en-GB">en-GB/plg_system_googletagmanager.sys.ini</language>
        <language tag="nl-NL">nl-NL/plg_system_googletagmanager.ini</language>
        <language tag="nl-NL">nl-NL/plg_system_googletagmanager.sys.ini</language>
    </languages>

    <media folder="media" destination="plg_system_googletagmanager">
        <folder>js</folder>
        <folder>css</folder>
    </media>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="container_id"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONTAINER_ID_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONTAINER_ID_DESC"
                />
                <field
                    name="server_side_tagging"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_TAGGING_LABEL"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="server_side_note"
                    type="note"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_NOTE_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="server_side_domain"
                    type="url"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_DOMAIN_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_DOMAIN_DESC"
                    filter="url"
                    showon="server_side_tagging:1"
                />
                <field
                    name="script_loader_url"
                    type="url"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SCRIPT_LOADER_URL_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SCRIPT_LOADER_URL_DESC"
                    filter="url"
                    showon="server_side_tagging:1"
                />
                <field
                    name="custom_loader_note"
                    type="note"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CUSTOM_LOADER_NOTE_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="stape_loader_script"
                    type="textarea"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_STAPE_LOADER_SCRIPT_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_STAPE_LOADER_SCRIPT_DESC"
                    rows="5"
                    showon="server_side_tagging:1"
                />
                <field
                    name="container_identifier"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONTAINER_IDENTIFIER_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONTAINER_IDENTIFIER_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="stape_api_key"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_STAPE_API_KEY_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_STAPE_API_KEY_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="cookie_keeper"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_COOKIE_KEEPER_LABEL"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_COOKIE_KEEPER_DESC"
                    showon="server_side_tagging:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="custom_loader_manual_note"
                    type="note"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CUSTOM_LOADER_MANUAL_NOTE_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="custom_script_filename"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CUSTOM_SCRIPT_FILENAME_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CUSTOM_SCRIPT_FILENAME_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="custom_script_params"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CUSTOM_SCRIPT_PARAMS_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CUSTOM_SCRIPT_PARAMS_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="server_side_path_note"
                    type="note"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_PATH_NOTE_DESC"
                    showon="server_side_tagging:1"
                />
                <field
                    name="server_side_path"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_PATH_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_SERVER_SIDE_PATH_DESC"
                    showon="server_side_tagging:1"
                />
            </fieldset>
            <fieldset name="consent_banner" label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELDSET_CONSENT_BANNER">
                <field
                    name="native_consent_banner"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_NATIVE_CONSENT_BANNER_LABEL"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_NATIVE_CONSENT_BANNER_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="native_banner_note"
                    type="note"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_NATIVE_BANNER_NOTE_DESC"
                    showon="native_consent_banner:1"
                />
                <field
                    name="consent_category_marketing"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONSENT_CATEGORY_MARKETING_LABEL"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONSENT_CATEGORY_MARKETING_DESC"
                    showon="native_consent_banner:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="consent_expiration_days"
                    type="number"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONSENT_EXPIRATION_DAYS_LABEL"
                    default="365"
                    min="1"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_CONSENT_EXPIRATION_DAYS_DESC"
                    showon="native_consent_banner:1"
                />
            </fieldset>
            <fieldset name="advanced" label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELDSET_ADVANCED">
                <field
                    name="gtm_environments_note"
                    type="note"
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_GTM_ENVIRONMENTS_NOTE_DESC"
                />
                <field
                    name="gtm_auth"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_GTM_AUTH_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_GTM_AUTH_DESC"
                />
                <field
                    name="gtm_preview"
                    type="text"
                    label="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_GTM_PREVIEW_LABEL"
                    default=""
                    description="PLG_SYSTEM_GOOGLETAGMANAGER_FIELD_GTM_PREVIEW_DESC"
                />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" name="Google Tag Manager Update Server">https://raw.githubusercontent.com/hans2103/plg_system_googletagmanager/main/update.xml</server>
    </updateservers>
</extension>
